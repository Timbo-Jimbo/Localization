  m_Script: {fileID: 11500000, guid: 62acb3805a8830446b2f71c4455c9958, type: 3}
  m_Name: Gemini
  m_EditorClassIdentifier: Assembly-CSharp-Editor::AiTranslator
  _glossaries:
  - {fileID: 11400000, guid: b37446ba09e3e1541b9b2b1baf94f991, type: 2}
  _contextBlocks:
  - _title: Freedom to rephrase
    _body: "You are free to reword and rework the source text as much as you want.
      \n\nThe only requirements is that overall meaning and intent is conveyed. A
      strict one-to-one translation is NOT required. \n\nDeviating from the source
      text is encouraged with an end goal of translations that feel extremely natural
      in the speakers langauge. Take the source text as a 'suggestion' of what we
      want to convey in the target language."
  - _title: Vibes
    _body: Maintain the energy and vibe of the source entry.
  _systemInstructions: 
  _model: gemini-3.5-flash
  _apiBaseUrl: https://generativelanguage.googleapis.com/v1beta/openai
  _timeoutSeconds: 480
  _temperature: 1
