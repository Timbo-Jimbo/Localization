  m_Script: {fileID: 11500000, guid: 5182171563d8a704b982ffd523a14724, type: 3}
  m_Name: HowToEarnMoreCash
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedString
  DebugContextInfo:
    Context: {fileID: 11400000}
    SourcePath: Assets/Localization/HowToEarnMoreCash.asset
